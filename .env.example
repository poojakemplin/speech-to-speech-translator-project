# Azure Speech Services
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here

# Azure OpenAI
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2023-12-01-preview

# Azure Translator (Optional - for backup translation)
AZURE_TRANSLATOR_KEY=your_translator_key_here
AZURE_TRANSLATOR_REGION=your_translator_region_here

# Application Settings
LOG_LEVEL=INFO
MAX_AUDIO_DURATION=300
SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE=1024

# OTT Platform Settings
OTT_STREAM_URL=your_ott_stream_url_here
OTT_API_KEY=your_ott_api_key_here

# Redis (for caching and queue management)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Performance Settings
MAX_CONCURRENT_TRANSLATIONS=10
TRANSLATION_TIMEOUT=30
BUFFER_SIZE=4096
